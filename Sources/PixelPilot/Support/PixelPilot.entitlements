<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The sandbox is deliberately off. DDC needs raw IOKit access, the media
	  keys need a system-wide event tap, and software dimming writes the display
	  gamma table. None of these have a sandbox entitlement.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
